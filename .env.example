# NirikshAi — Environment Configuration
# Copy this file to .env and fill in values before running.
# NEVER commit .env to git.

# ── Application Mode ──────────────────────────────────────────────────────
# demo     = pre-seeded data, simulation labels visible, demo banner shown
# staging  = real data, simulated integrations labeled
# prod     = production (requires all integrations configured)
APP_MODE=demo

# ── Security ──────────────────────────────────────────────────────────────
# CRITICAL: Replace with a cryptographically random 256-bit secret in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
NIRIKSHAI_JWT_SECRET=REPLACE_WITH_256_BIT_RANDOM_SECRET_BEFORE_PRODUCTION

# Token expiry in minutes (default: 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production: replace with your actual deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
# Default: SQLite at project root (demo only).
# Production: Use PostgreSQL or managed DB.
# DATABASE_URL=postgresql://user:password@host:5432/nirikshai

# ── CCTV / RTSP ───────────────────────────────────────────────────────────
# RTSP credentials MUST come from environment — never hardcode in source.
# RTSP_USERNAME=your_camera_username
# RTSP_PASSWORD=your_camera_password
# RTSP_URL=rtsp://your-camera-ip:554/stream

# ── HTTPS / HSTS ─────────────────────────────────────────────────────────
# Set to "true" ONLY when serving over HTTPS in production.
ENABLE_HSTS=false

# ── Video Verification ────────────────────────────────────────────────────
# Integrate a WebRTC provider in production (e.g., Daily.co, Jitsi).
# VC_PROVIDER=daily
# DAILY_API_KEY=your_daily_api_key
